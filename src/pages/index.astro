---
import LabLayout from "../layouts/LabLayout.astro";
import { projects } from "../projects";

const base = import.meta.env.BASE_URL;
---

<LabLayout title="Lab" description="Small experiments in interface design.">
  <main>
    <h1>Lab</h1>
    <p class="lede">Small experiments in interface design.</p>
    <ul>
      {
        projects.map((p) => (
          <li>
            <a href={`${base}${p.slug}/`}>
              <strong>{p.title}</strong>
              <span>{p.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</LabLayout>

<style>
  main { max-width: 640px; margin: 0 auto; padding: 96px 24px 120px; }
  h1 { font-size: 40px; font-weight: 650; margin: 0 0 8px; }
  .lede { color: var(--lab-muted); margin: 0 0 40px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  a { display: grid; gap: 4px; padding: 16px 18px; border: 1px solid var(--lab-line); border-radius: 12px; color: inherit; text-decoration: none; }
  a:hover { border-color: var(--lab-muted); }
  a span { color: var(--lab-muted); font-size: 14px; }
</style>
