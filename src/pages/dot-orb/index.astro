---
import LabLayout from "../../layouts/LabLayout.astro";

const file = `${import.meta.env.BASE_URL}dot-orb/dot-orb-page.js`;

const states = ["sphere", "swell", "sweep", "halftone", "converge", "ripple", "check", "tremor"];
---

<LabLayout title="Dot orb" description="A ball of dots that reshapes itself for each state: sphere, swell, sweep, halftone, converge, ripple, check and tremor.">
  <script is:inline type="module" src={file}></script>

  <main class="dorb">
    <section class="dorb-stage">
      <div class="dorb-hero">
        <button type="button" id="dorb-hit" class="dorb-hit" aria-label="Pause or resume the loop" aria-pressed="false">
          <span id="dorb-hero" class="dorb-orb" data-n="900" data-size="320"></span>
        </button>
        <p id="dorb-name" class="dorb-sr" aria-live="polite">sphere</p>
      </div>
      <div class="dorb-picker" role="group" aria-label="State">
        {
          states.map((s) => (
            <button type="button" data-state={s} aria-pressed="false">
              <span class="dorb-orb" data-n="90" data-size="40" />
              <span class="dorb-cap">{s}</span>
            </button>
          ))
        }
      </div>
    </section>
  </main>
</LabLayout>

<style is:global>
  .dorb {
    --dorb-fg: var(--lab-fg);
    --dorb-mute: var(--lab-muted);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 16px 72px; /* the bottom keeps the picker clear of the brand and Share buttons */
  }
  /* The picker is anchored to the bottom, above the brand and Share buttons; the
     orb takes all the room above it and sits in the middle of that room. */
  .dorb-stage {
    width: min(900px, 100%);
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .dorb-picker button:focus-visible,
  .dorb-hit:focus-visible {
    outline: 2px solid var(--dorb-fg);
    outline-offset: 3px;
    border-radius: 8px;
  }
  .dorb-hero {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .dorb-hit {
    display: block;
    width: 100%;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    line-height: 0;
  }
  .dorb-orb {
    display: inline-flex;
    line-height: 0;
  }
  .dorb-hit .dorb-orb {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  /* The state's name is announced to screen readers; sighted users read the picker. */
  .dorb-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .dorb-picker {
    display: grid;
    grid-template-columns: repeat(8, 1fr); /* one row on a wide screen, two even rows of four on a phone */
    gap: 8px 4px;
    width: 100%;
    max-width: 720px;
  }
  .dorb-picker button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font: inherit;
    font-size: 12px;
    color: var(--dorb-mute);
    background: none;
    border: 0;
    padding: 8px 0 6px;
    border-radius: 12px;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .dorb-picker button[aria-pressed="true"] {
    color: var(--dorb-fg);
    background: var(--lab-line);
  }
  .dorb-cap {
    text-transform: capitalize;
  }

  @media (max-width: 560px) {
    .dorb-picker {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dorb-picker button {
      transition: none;
    }
  }
</style>
