---
import LabLayout from "../../layouts/LabLayout.astro";
import { SHAPES } from "../../projects/voice-doodle/ribbon";

const shapes = Object.keys(SHAPES);
---

<LabLayout
  title="Voice doodle"
  description="A scribble that comes alive when it speaks. A canvas ribbon driven by a voice level."
>
  <main>
    <div class="stage">
      <canvas id="doodle" role="img" aria-label="A looping scribble that ripples while it speaks"></canvas>
    </div>
    <div class="controls">
      <button id="play" type="button" class="play" aria-pressed="false">Play</button>
      <div class="chips" role="group" aria-label="Shape">
        {
          shapes.map((name) => (
            <button type="button" data-shape={name} aria-pressed={name === "loop"}>
              {name}
            </button>
          ))
        }
      </div>
    </div>
  </main>
</LabLayout>

<script>
  import "../../projects/voice-doodle/doodle";
</script>

<style is:global>
  :root {
    --lab-bg: #0c0c0d;
    --lab-fg: #f2f1f4;
    --lab-muted: #8a8990;
    --lab-chip: rgb(28 28 30 / 0.7);
    --lab-line: rgb(255 255 255 / 0.12);
  }
</style>

<style>
  main { min-height: 100svh; display: grid; place-content: center; gap: 28px; padding: 24px 16px 96px; justify-items: center; }
  .stage { width: min(320px, 78vw); aspect-ratio: 1; border-radius: 28px; background: #1c1c1e; border: 1px solid var(--lab-line); }
  canvas { width: 100%; height: 100%; display: block; }
  .controls { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .play { width: 84px; height: 44px; border: 0; border-radius: 999px; background: #f2f0f5; color: #111; font: inherit; font-size: 14px; cursor: pointer; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chips button { font: inherit; font-size: 13px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--lab-line); background: transparent; color: var(--lab-muted); cursor: pointer; }
  .chips button[aria-pressed="true"] { background: #c8e26a; color: #1a1f08; border-color: transparent; }
  button:focus-visible { outline: 2px solid #c8e26a; outline-offset: 2px; }
</style>
