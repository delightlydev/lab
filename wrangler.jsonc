{
  "name": "delightly-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "delightly.dev/lab/*", "zone_name": "delightly.dev" }]
}
